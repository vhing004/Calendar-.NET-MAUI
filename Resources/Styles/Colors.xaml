<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Primary palette (Indigo/Purple/Pink – matching original HTML) -->
    <Color x:Key="Primary">#6366f1</Color>
    <Color x:Key="PrimaryDark">#4f46e5</Color>
    <Color x:Key="PrimaryLight">#e0e7ff</Color>
    <Color x:Key="Secondary">#a855f7</Color>
    <Color x:Key="Accent">#ec4899</Color>

    <!-- Neutral -->
    <Color x:Key="Background">#F8FAFC</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="TextPrimary">#1e293b</Color>
    <Color x:Key="TextSecondary">#64748b</Color>
    <Color x:Key="TextMuted">#94a3b8</Color>
    <Color x:Key="Border">#e2e8f0</Color>

    <!-- Status -->
    <Color x:Key="Success">#10b981</Color>
    <Color x:Key="Warning">#f59e0b</Color>
    <Color x:Key="Danger">#ef4444</Color>

    <!-- Dark mode -->
    <Color x:Key="DarkBackground">#0f172a</Color>
    <Color x:Key="DarkSurface">#1e293b</Color>
    <Color x:Key="DarkBorder">#334155</Color>
</ResourceDictionary>
