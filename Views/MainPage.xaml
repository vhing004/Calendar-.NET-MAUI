<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LichBieu.ViewModels"
             xmlns:conv="clr-namespace:LichBieu.Converters"
             xmlns:models="clr-namespace:LichBieu.Models"
             x:Class="LichBieu.Views.MainPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <conv:TabActiveBackgroundConverter    x:Key="TabBg"/>
        <conv:TabActiveOpacityConverter       x:Key="TabOpacity"/>
        <conv:FilterActiveBackgroundConverter x:Key="FilterBg"/>
        <conv:FilterActiveTextColorConverter  x:Key="FilterText"/>
        <conv:TabVisibilityConverter          x:Key="TabVis"/>
        <conv:CompletedToDecorationConverter  x:Key="CompletedDeco"/>
        <conv:CompletedToOpacityConverter     x:Key="CompletedOpacity"/>
        <conv:RatioToHeightConverter          x:Key="RatioHeight"/>
        <conv:InverseBoolConverter            x:Key="InvBool"/>
        <conv:StringIsNotEmptyConverter       x:Key="NotEmpty"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" BackgroundColor="{StaticResource Background}">

        <!-- HEADER -->
        <Grid Grid.Row="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#6366f1" Offset="0"/>
                    <GradientStop Color="#a855f7" Offset="0.5"/>
                    <GradientStop Color="#ec4899" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <VerticalStackLayout Padding="16,12,16,0" Spacing="0">
                <!-- Top row -->
                <Grid ColumnDefinitions="44,*,44,60,90" ColumnSpacing="8" Margin="0,0,0,10">
                    <Border Grid.Column="0" BackgroundColor="#33FFFFFF" StrokeShape="RoundRectangle 10"
                            StrokeThickness="0" Padding="0" WidthRequest="40" HeightRequest="40">
                        <Label Text="📅" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                        <Label Text="Lịch Biểu Cá Nhân" FontSize="17" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Chào mừng bạn!" FontSize="11" TextColor="#CCFFFFFF"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="2" x:Name="BtnTheme" Text="🌙" FontSize="16"
                            BackgroundColor="Transparent" TextColor="White"
                            Padding="4" Clicked="OnThemeToggleClicked"/>
                    <Border Grid.Column="3" BackgroundColor="#33FFFFFF" StrokeShape="RoundRectangle 8"
                            StrokeThickness="0" Padding="0" HeightRequest="34">
                        <Label Text="VI" TextColor="White" FontSize="13" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Button Grid.Column="4" Text="+ Thêm mới"
                            BackgroundColor="White" TextColor="#6366f1"
                            CornerRadius="8" FontAttributes="Bold" FontSize="12"
                            HeightRequest="36" Padding="8,0" Clicked="OnAddItemClicked"/>
                </Grid>
                <!-- Nav tabs -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="4" Padding="0,0,0,10">
                        <Button Text="📅 Lịch"
                                BackgroundColor="{Binding CurrentTabIndex, Converter={StaticResource TabBg}, ConverterParameter=0}"
                                Opacity="{Binding CurrentTabIndex, Converter={StaticResource TabOpacity}, ConverterParameter=0}"
                                TextColor="White" CornerRadius="8" FontSize="13" Padding="12,6"
                                CommandParameter="0" Command="{Binding SwitchTabCommand}"/>
                        <Button Text="✅ Công việc"
                                BackgroundColor="{Binding CurrentTabIndex, Converter={StaticResource TabBg}, ConverterParameter=1}"
                                Opacity="{Binding CurrentTabIndex, Converter={StaticResource TabOpacity}, ConverterParameter=1}"
                                TextColor="White" CornerRadius="8" FontSize="13" Padding="12,6"
                                CommandParameter="1" Command="{Binding SwitchTabCommand}"/>
                        <Button Text="📊 Thống kê"
                                BackgroundColor="{Binding CurrentTabIndex, Converter={StaticResource TabBg}, ConverterParameter=2}"
                                Opacity="{Binding CurrentTabIndex, Converter={StaticResource TabOpacity}, ConverterParameter=2}"
                                TextColor="White" CornerRadius="8" FontSize="13" Padding="12,6"
                                CommandParameter="2" Command="{Binding SwitchTabCommand}"/>
                        <Button Text="🔍 Tìm kiếm"
                                BackgroundColor="{Binding CurrentTabIndex, Converter={StaticResource TabBg}, ConverterParameter=3}"
                                Opacity="{Binding CurrentTabIndex, Converter={StaticResource TabOpacity}, ConverterParameter=3}"
                                TextColor="White" CornerRadius="8" FontSize="13" Padding="12,6"
                                CommandParameter="3" Command="{Binding SwitchTabCommand}"/>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </Grid>

        <!-- CONTENT -->
        <ScrollView Grid.Row="1">
            <Grid>

                <!-- TAB 0: CALENDAR -->
                <VerticalStackLayout Padding="16" Spacing="12"
                    IsVisible="{Binding CurrentTabIndex, Converter={StaticResource TabVis}, ConverterParameter=0}">
                    <Border BackgroundColor="White" StrokeShape="RoundRectangle 16"
                            StrokeThickness="0" Padding="16" Shadow="{StaticResource DefaultShadow}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="44,*,44">
                                <Button Grid.Column="0" Text="◀" FontSize="15" BackgroundColor="Transparent"
                                        TextColor="#374151" Padding="0" Command="{Binding PreviousMonthCommand}"/>
                                <Label Grid.Column="1" Text="{Binding CurrentMonthLabel}"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       FontSize="16" FontAttributes="Bold" TextColor="#1e293b"/>
                                <Button Grid.Column="2" Text="▶" FontSize="15" BackgroundColor="Transparent"
                                        TextColor="#374151" Padding="0" Command="{Binding NextMonthCommand}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                                <Label Grid.Column="0" Text="CN" HorizontalOptions="Center" FontSize="11" TextColor="#94a3b8"/>
                                <Label Grid.Column="1" Text="T2" HorizontalOptions="Center" FontSize="11" TextColor="#94a3b8"/>
                                <Label Grid.Column="2" Text="T3" HorizontalOptions="Center" FontSize="11" TextColor="#94a3b8"/>
                                <Label Grid.Column="3" Text="T4" HorizontalOptions="Center" FontSize="11" TextColor="#94a3b8"/>
                                <Label Grid.Column="4" Text="T5" HorizontalOptions="Center" FontSize="11" TextColor="#94a3b8"/>
                                <Label Grid.Column="5" Text="T6" HorizontalOptions="Center" FontSize="11" TextColor="#94a3b8"/>
                                <Label Grid.Column="6" Text="T7" HorizontalOptions="Center" FontSize="11" TextColor="#94a3b8"/>
                            </Grid>
                            <CollectionView ItemsSource="{Binding CalendarDays}" SelectionMode="None"
                                            HeightRequest="{Binding CalendarGridHeight}">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="7"
                                                     HorizontalItemSpacing="2" VerticalItemSpacing="2"/>
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CalendarDayViewModel">
                                        <Grid HeightRequest="40" WidthRequest="40">
                                            <BoxView IsVisible="{Binding IsEmpty}" BackgroundColor="Transparent"/>
                                            <Border IsVisible="{Binding IsEmpty, Converter={StaticResource InvBool}}"
                                                    BackgroundColor="{Binding DayBackground}"
                                                    StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="0">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnDayTapped"/>
                                                </Border.GestureRecognizers>
                                                <Grid>
                                                    <Label Text="{Binding Day}"
                                                           TextColor="{Binding DayTextColor}"
                                                           HorizontalOptions="Center" VerticalOptions="Center"
                                                           FontSize="13" FontAttributes="{Binding DayFontAttr}"/>
                                                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="#ec4899"
                                                             VerticalOptions="End" HorizontalOptions="Center"
                                                             Margin="0,0,0,2" IsVisible="{Binding HasItems}"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="White" StrokeShape="RoundRectangle 16"
                            StrokeThickness="0" Padding="16" Shadow="{StaticResource DefaultShadow}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding SelectedDateLabel}"
                                       FontSize="15" FontAttributes="Bold" TextColor="#1e293b"/>
                                <Border Grid.Column="1" BackgroundColor="#e0e7ff"
                                        StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="8,4">
                                    <Label Text="{Binding EventCountLabel}" FontSize="11" TextColor="#6366f1"/>
                                </Border>
                            </Grid>
                            <CollectionView ItemsSource="{Binding DayEvents}">
                                <CollectionView.EmptyView>
                                    <Label Text="Không có sự kiện nào" HorizontalOptions="Center"
                                           TextColor="#94a3b8" FontSize="13" Margin="0,16"/>
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:CalendarItem">
                                        <Border Margin="0,3" Padding="12" BackgroundColor="#f8fafc"
                                                StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                            <Grid ColumnDefinitions="*,44,44" ColumnSpacing="4">
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <Label FontSize="14" FontAttributes="Bold" TextColor="#1e293b">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding CategoryEmoji}" FontSize="15"/>
                                                                <Span Text=" "/>
                                                                <Span Text="{Binding Title}" FontAttributes="Bold" TextColor="#1e293b"/>
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    <Label Text="{Binding TimeDisplay}" FontSize="11" TextColor="#64748b"
                                                           IsVisible="{Binding TimeDisplay, Converter={StaticResource NotEmpty}}"/>
                                                    <Label Text="{Binding Location}" FontSize="11" TextColor="#64748b"
                                                           IsVisible="{Binding Location, Converter={StaticResource NotEmpty}}"/>
                                                </VerticalStackLayout>
                                                <Button Grid.Column="1" Text="✏️" FontSize="15"
                                                        BackgroundColor="Transparent" Padding="4" Clicked="OnEditItemClicked"/>
                                                <Button Grid.Column="2" Text="🗑️" FontSize="15"
                                                        BackgroundColor="Transparent" Padding="4" Clicked="OnDeleteItemClicked"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- TAB 1: TASKS -->
                <VerticalStackLayout Padding="16" Spacing="12"
                    IsVisible="{Binding CurrentTabIndex, Converter={StaticResource TabVis}, ConverterParameter=1}">
                    <Border BackgroundColor="White" StrokeShape="RoundRectangle 16"
                            StrokeThickness="0" Padding="16" Shadow="{StaticResource DefaultShadow}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="📋 Danh sách công việc" FontSize="15" FontAttributes="Bold" TextColor="#1e293b"/>
                            <HorizontalStackLayout Spacing="6">
                                <Border StrokeShape="RoundRectangle 14" StrokeThickness="0" Padding="10,5"
                                        BackgroundColor="{Binding TaskFilter, Converter={StaticResource FilterBg}, ConverterParameter=all}">
                                    <Label Text="Tất cả" FontSize="12"
                                           TextColor="{Binding TaskFilter, Converter={StaticResource FilterText}, ConverterParameter=all}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SetTaskFilterCommand}" CommandParameter="all"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Border>
                                <Border StrokeShape="RoundRectangle 14" StrokeThickness="0" Padding="10,5"
                                        BackgroundColor="{Binding TaskFilter, Converter={StaticResource FilterBg}, ConverterParameter=pending}">
                                    <Label Text="Chưa xong" FontSize="12"
                                           TextColor="{Binding TaskFilter, Converter={StaticResource FilterText}, ConverterParameter=pending}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SetTaskFilterCommand}" CommandParameter="pending"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Border>
                                <Border StrokeShape="RoundRectangle 14" StrokeThickness="0" Padding="10,5"
                                        BackgroundColor="{Binding TaskFilter, Converter={StaticResource FilterBg}, ConverterParameter=completed}">
                                    <Label Text="Đã xong" FontSize="12"
                                           TextColor="{Binding TaskFilter, Converter={StaticResource FilterText}, ConverterParameter=completed}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SetTaskFilterCommand}" CommandParameter="completed"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Border>
                            </HorizontalStackLayout>
                            <CollectionView ItemsSource="{Binding TasksList}">
                                <CollectionView.EmptyView>
                                    <Label Text="Chưa có công việc nào" HorizontalOptions="Center"
                                           TextColor="#94a3b8" FontSize="13" Margin="0,16"/>
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:CalendarItem">
                                        <Border Margin="0,3" Padding="12" BackgroundColor="#f8fafc"
                                                StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                            <Grid ColumnDefinitions="Auto,*,44,44" ColumnSpacing="8">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding Completed}"
                                                          CheckedChanged="OnTaskCheckedChanged"
                                                          Color="#6366f1" VerticalOptions="Center"/>
                                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                    <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold"
                                                           TextColor="#1e293b"
                                                           TextDecorations="{Binding Completed, Converter={StaticResource CompletedDeco}}"
                                                           Opacity="{Binding Completed, Converter={StaticResource CompletedOpacity}}"/>
                                                    <Label Text="{Binding PriorityLabel}" FontSize="11" TextColor="#64748b"/>
                                                    <Label Text="{Binding Date}" FontSize="11" TextColor="#94a3b8"/>
                                                </VerticalStackLayout>
                                                <Button Grid.Column="2" Text="✏️" FontSize="15"
                                                        BackgroundColor="Transparent" Padding="4" Clicked="OnEditItemClicked"/>
                                                <Button Grid.Column="3" Text="🗑️" FontSize="15"
                                                        BackgroundColor="Transparent" Padding="4" Clicked="OnDeleteItemClicked"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 14" StrokeThickness="0" Padding="16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#10b981" Offset="0"/>
                                    <GradientStop Color="#0d9488" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Hoàn thành" FontSize="12" TextColor="#CCFFFFFF"/>
                                <Label Text="{Binding CompletedTaskCount}" FontSize="32" FontAttributes="Bold" TextColor="White"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" StrokeShape="RoundRectangle 14" StrokeThickness="0" Padding="16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#f59e0b" Offset="0"/>
                                    <GradientStop Color="#ea580c" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Đang chờ" FontSize="12" TextColor="#CCFFFFFF"/>
                                <Label Text="{Binding PendingTaskCount}" FontSize="32" FontAttributes="Bold" TextColor="White"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- TAB 2: STATS -->
                <VerticalStackLayout Padding="16" Spacing="12"
                    IsVisible="{Binding CurrentTabIndex, Converter={StaticResource TabVis}, ConverterParameter=2}">
                    <Border BackgroundColor="White" StrokeShape="RoundRectangle 16"
                            StrokeThickness="0" Padding="16" Shadow="{StaticResource DefaultShadow}">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="📊 Thống kê hoạt động" FontSize="15" FontAttributes="Bold" TextColor="#1e293b"/>
                            <Label Text="Phân bổ theo danh mục" FontSize="12" TextColor="#64748b"/>
                            <CollectionView ItemsSource="{Binding CategoryStats}">
                                <CollectionView.EmptyView>
                                    <Label Text="Chưa có dữ liệu" HorizontalOptions="Center" TextColor="#94a3b8" FontSize="13"/>
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CategoryStatItem">
                                        <VerticalStackLayout Spacing="4" Margin="0,4">
                                            <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="8">
                                                <Label Grid.Column="0" Text="{Binding Emoji}" FontSize="18"/>
                                                <Label Grid.Column="1" Text="{Binding Label}" FontSize="13"
                                                       TextColor="#374151" VerticalOptions="Center"/>
                                                <Label Grid.Column="2" Text="{Binding Display}" FontSize="12"
                                                       TextColor="#64748b" VerticalOptions="Center"/>
                                            </Grid>
                                            <Grid HeightRequest="8">
                                                <Border BackgroundColor="#e2e8f0" StrokeShape="RoundRectangle 4"
                                                        StrokeThickness="0" HeightRequest="8"/>
                                                <Border BackgroundColor="{Binding BarColor}" StrokeShape="RoundRectangle 4"
                                                        StrokeThickness="0" HeightRequest="8"
                                                        HorizontalOptions="Start" WidthRequest="{Binding BarWidth}"/>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <BoxView HeightRequest="1" Color="#e2e8f0"/>
                            <Label Text="Hoạt động trong tuần" FontSize="12" TextColor="#64748b"/>
                            <CollectionView ItemsSource="{Binding WeekBars}" HeightRequest="160">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WeekBarItem">
                                        <VerticalStackLayout WidthRequest="38" HeightRequest="150"
                                                             VerticalOptions="End" HorizontalOptions="Center">
                                            <BoxView BackgroundColor="Transparent" VerticalOptions="FillAndExpand"/>
                                            <BoxView BackgroundColor="#6366f1" CornerRadius="3"
                                                     HeightRequest="{Binding BarHeight}" HorizontalOptions="Fill"/>
                                            <Label Text="{Binding Label}" FontSize="10" TextColor="#94a3b8"
                                                   HorizontalOptions="Center" Margin="0,4,0,0"/>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" BackgroundColor="White" StrokeShape="RoundRectangle 14"
                                StrokeThickness="0" Padding="16" Shadow="{StaticResource DefaultShadow}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Tổng sự kiện" FontSize="12" TextColor="#64748b"/>
                                <Label Text="{Binding TotalEvents}" FontSize="32" FontAttributes="Bold" TextColor="#6366f1"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="White" StrokeShape="RoundRectangle 14"
                                StrokeThickness="0" Padding="16" Shadow="{StaticResource DefaultShadow}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Tỷ lệ hoàn thành" FontSize="12" TextColor="#64748b"/>
                                <Label Text="{Binding CompletionRate}" FontSize="32" FontAttributes="Bold" TextColor="#10b981"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- TAB 3: SEARCH -->
                <VerticalStackLayout Padding="16" Spacing="12"
                    IsVisible="{Binding CurrentTabIndex, Converter={StaticResource TabVis}, ConverterParameter=3}">
                    <Border BackgroundColor="White" StrokeShape="RoundRectangle 16"
                            StrokeThickness="0" Padding="16" Shadow="{StaticResource DefaultShadow}">
                        <VerticalStackLayout Spacing="12">
                            <Border Stroke="#e2e8f0" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                                <Entry Placeholder="🔍 Tìm kiếm sự kiện, công việc..."
                                       Text="{Binding SearchQuery}"
                                       PlaceholderColor="#94a3b8" TextColor="#1e293b"
                                       FontSize="14" Margin="10,0"/>
                            </Border>
                            <HorizontalStackLayout Spacing="6">
                                <Border StrokeShape="RoundRectangle 14" StrokeThickness="0" Padding="10,5"
                                        BackgroundColor="{Binding SearchFilter, Converter={StaticResource FilterBg}, ConverterParameter=all}">
                                    <Label Text="Tất cả" FontSize="12"
                                           TextColor="{Binding SearchFilter, Converter={StaticResource FilterText}, ConverterParameter=all}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SetSearchFilterCommand}" CommandParameter="all"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Border>
                                <Border StrokeShape="RoundRectangle 14" StrokeThickness="0" Padding="10,5"
                                        BackgroundColor="{Binding SearchFilter, Converter={StaticResource FilterBg}, ConverterParameter=event}">
                                    <Label Text="Sự kiện" FontSize="12"
                                           TextColor="{Binding SearchFilter, Converter={StaticResource FilterText}, ConverterParameter=event}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SetSearchFilterCommand}" CommandParameter="event"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Border>
                                <Border StrokeShape="RoundRectangle 14" StrokeThickness="0" Padding="10,5"
                                        BackgroundColor="{Binding SearchFilter, Converter={StaticResource FilterBg}, ConverterParameter=task}">
                                    <Label Text="Công việc" FontSize="12"
                                           TextColor="{Binding SearchFilter, Converter={StaticResource FilterText}, ConverterParameter=task}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SetSearchFilterCommand}" CommandParameter="task"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Border>
                                <Border StrokeShape="RoundRectangle 14" StrokeThickness="0" Padding="10,5"
                                        BackgroundColor="{Binding SearchFilter, Converter={StaticResource FilterBg}, ConverterParameter=upcoming}">
                                    <Label Text="Sắp tới" FontSize="12"
                                           TextColor="{Binding SearchFilter, Converter={StaticResource FilterText}, ConverterParameter=upcoming}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SetSearchFilterCommand}" CommandParameter="upcoming"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <CollectionView ItemsSource="{Binding SearchResults}">
                        <CollectionView.EmptyView>
                            <Label Text="Nhập từ khóa để tìm kiếm" HorizontalOptions="Center"
                                   TextColor="#94a3b8" FontSize="13" Margin="0,24"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CalendarItem">
                                <Border Margin="0,4" Padding="12" BackgroundColor="White"
                                        StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                        Shadow="{StaticResource DefaultShadow}">
                                    <Grid ColumnDefinitions="36,*,44,44" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="{Binding CategoryEmoji}" FontSize="22" VerticalOptions="Center"/>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" TextColor="#1e293b"/>
                                            <Label Text="{Binding Date}" FontSize="11" TextColor="#94a3b8"/>
                                            <Label Text="{Binding CategoryLabel}" FontSize="11" TextColor="#6366f1"/>
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2" Text="✏️" FontSize="15"
                                                BackgroundColor="Transparent" Padding="4" Clicked="OnEditItemClicked"/>
                                        <Button Grid.Column="3" Text="🗑️" FontSize="15"
                                                BackgroundColor="Transparent" Padding="4" Clicked="OnDeleteItemClicked"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
